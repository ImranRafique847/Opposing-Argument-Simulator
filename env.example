# Copy this file to .env and fill in your actual tokens.
# Never commit the real .env file — it is in .gitignore.

# Hugging Face token (for CAP dataset streaming)
HF_TOKEN=

# AWS credentials (Bedrock + RDS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# CourtListener API token — free at https://www.courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=

# Kaggle API credentials — from https://www.kaggle.com/settings -> API
KAGGLE_USERNAME=
KAGGLE_KEY=

# GitHub token (for pushing from scripts if needed)
GITHUB_TOKEN=

# Amazon RDS PostgreSQL (pgvector)
DB_HOST=
DB_PORT=5432
DB_NAME=opposingargdb
DB_USER=postgres
DB_PASSWORD=
