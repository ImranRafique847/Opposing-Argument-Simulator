# Copy this file to .env and fill in your actual tokens.
# Never commit the real .env file — it is in .gitignore.

# Hugging Face token (for CAP dataset streaming if/when gated access is approved)
HF_TOKEN=

# CourtListener API token — free account at https://www.courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=

# Kaggle API credentials — from https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
